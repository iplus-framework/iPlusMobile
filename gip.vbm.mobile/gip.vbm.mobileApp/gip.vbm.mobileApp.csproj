<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-android</TargetFrameworks>
		<!-- <TargetFrameworks>$(TargetFrameworks);net10.0-tizen</TargetFrameworks> -->
		<OutputType>Exe</OutputType>
		<RootNamespace>gip.vbm.mobileApp</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>

		<!-- Suppress MA002 SDK warning -->
		<SkipValidateMauiImplicitPackageReferences>true</SkipValidateMauiImplicitPackageReferences>

		<!-- Android Optimization & Alignment -->
		<AndroidZipAlign>true</AndroidZipAlign>

		<RuntimeIdentifiers>android-arm;android-arm64</RuntimeIdentifiers>

		<!-- Display name -->
		<ApplicationTitle>gip.vbm.mobileApp</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.companyname.gip.vbm.mobileapp</ApplicationId>
		<ApplicationIdGuid>BFD13D1B-20AB-4AAA-B23E-BBE93AA8BBE0</ApplicationIdGuid>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">14.2</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">14.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'tizen'">6.5</SupportedOSPlatformVersion>
		<Configurations>Debug;Release;ReleaseDatalogic;DebugDatalogic;DebugZebra;ReleaseZebra</Configurations>
		<AndroidManifest>Platforms\Android\$(Configuration)\AndroidManifest.xml</AndroidManifest>
	</PropertyGroup>

	<!-- AUTOMATIC APK SIGNING CONFIGURATION FOR RELEASE BUILDS -->
	<PropertyGroup Condition="$(TargetFramework.Contains('-android')) and $(Configuration.StartsWith('Release'))">
		<AndroidPackageFormat>apk</AndroidPackageFormat>
		<AndroidKeyStore>true</AndroidKeyStore>
		<AndroidSigningKeyStore>$(MY_KEYSTORE_PATH)</AndroidSigningKeyStore>
		<AndroidSigningKeyAlias>iplusmobile</AndroidSigningKeyAlias>
		<!-- REPLACE WITH YOUR ACTUAL KEYSTORE PASSWORD -->
		<AndroidSigningKeyPass>$(MY_KEYSTORE_PASS)</AndroidSigningKeyPass>
		<AndroidSigningStorePass>$(MY_KEYSTORE_PASS)</AndroidSigningStorePass>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='DebugDatalogic|net10.0-android|AnyCPU'">
		<DefineConstants>$(DefineConstants)TRACE;DATALOGIC</DefineConstants>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='DebugZebra|net10.0-android|AnyCPU'">
		<DefineConstants>$(DefineConstants)TRACE;ZEBRA</DefineConstants>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net10.0-android|AnyCPU'">
		<DefineConstants>$(DefineConstants)TRACE;ZXING</DefineConstants>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net10.0-android|AnyCPU'">
		<DefineConstants>$(DefineConstants)TRACE;ZXING</DefineConstants>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='ReleaseDatalogic|net10.0-android|AnyCPU'">
		<DefineConstants>$(DefineConstants)TRACE;DATALOGIC</DefineConstants>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='ReleaseZebra|net10.0-android|AnyCPU'">
		<DefineConstants>$(DefineConstants)TRACE;ZEBRA</DefineConstants>
	</PropertyGroup>

	<PropertyGroup>
		<ILLinkPackVersion>8.0.100-1.23067.1</ILLinkPackVersion>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net10.0-android|AnyCPU'">
		<EmbedAssembliesIntoApk>True</EmbedAssembliesIntoApk>
		<DefineConstants>$(DefineConstants);ZXING</DefineConstants>
		<AndroidPackageFormat>apk</AndroidPackageFormat>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net10.0-android|AnyCPU'">
		<EmbedAssembliesIntoApk Condition="$([MSBuild]::IsOSPlatform('Linux'))">True</EmbedAssembliesIntoApk>
		<EmbedAssembliesIntoApk Condition="!$([MSBuild]::IsOSPlatform('Linux'))">False</EmbedAssembliesIntoApk>
		<DefineConstants>$(DefineConstants);ZXING</DefineConstants>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='DebugDatalogic|net10.0-android|AnyCPU'">
		<EmbedAssembliesIntoApk Condition="$([MSBuild]::IsOSPlatform('Linux'))">True</EmbedAssembliesIntoApk>
		<EmbedAssembliesIntoApk Condition="!$([MSBuild]::IsOSPlatform('Linux'))">False</EmbedAssembliesIntoApk>
		<DefineConstants>$(DefineConstants);DATALOGIC</DefineConstants>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='DebugZebra|net10.0-android|AnyCPU'">
		<EmbedAssembliesIntoApk Condition="$([MSBuild]::IsOSPlatform('Linux'))">True</EmbedAssembliesIntoApk>
		<EmbedAssembliesIntoApk Condition="!$([MSBuild]::IsOSPlatform('Linux'))">False</EmbedAssembliesIntoApk>
		<DefineConstants>$(DefineConstants);ZEBRA</DefineConstants>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='ReleaseDatalogic|net10.0-android|AnyCPU'">
		<EmbedAssembliesIntoApk>True</EmbedAssembliesIntoApk>
		<Optimize>True</Optimize>
		<DefineConstants>$(DefineConstants);DATALOGIC</DefineConstants>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='ReleaseZebra|net10.0-android|AnyCPU'">
		<EmbedAssembliesIntoApk>True</EmbedAssembliesIntoApk>
		<Optimize>True</Optimize>
		<DefineConstants>$(DefineConstants);ZEBRA</DefineConstants>
	</PropertyGroup>

	<!-- Cleaned single ItemGroup for primary dependencies -->
	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.30" />
		<PackageReference Include="datalogic-xamarin-sdk" Version="1.46.0" />
		<PackageReference Include="Microsoft.NET.ILLink.Tasks" Version="10.0.2" />
		<PackageReference Include="Microsoft.NET.ILLink.Analyzers" Version="$(ILLinkPackVersion)" />
	</ItemGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" Color="#00FFFFFF" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#FFFFFF" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\gip.vbm.mobile\gip.vbm.mobile\gip.vbm.mobile.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Folder Include="Resources\Images\" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0-android' And ('$(Configuration)' == 'DebugDatalogic' Or '$(Configuration)' == 'ReleaseDatalogic')">
		<PackageReference Include="datalogic-xamarin-sdk" Version="1.29.8975" />
	</ItemGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0-android' And ('$(Configuration)' == 'DebugZebra' Or '$(Configuration)' == 'ReleaseZebra')">
		<PackageReference Include="Symbol.XamarinEMDK" Version="8.0.0.9" />
	</ItemGroup>

	<ItemGroup>
		<None Update="Platforms\Android\DebugDatalogic\AndroidManifest.xml" LogicalName="DatalogicAndroidManifest.xml" />
		<None Update="Platforms\Android\ReleaseDatalogic\AndroidManifest.xml">
			<LogicalName>DatalogicAndroidManifest.xml</LogicalName>
		</None>
	</ItemGroup>

</Project>