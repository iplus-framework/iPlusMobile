{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "run-debug-android-usb",
            "command": "dotnet",
            "type": "shell",
            "args": [
                "build",
                "-t:Run",
                "${workspaceFolder}/gip.vbm.mobileApp/gip.vbm.mobileApp.csproj",
                "-p:TargetFramework=net10.0-android",
                "-p:Configuration=DebugZebra",
                "-p:AndroidAttachDebugger=true",
                "-p:AndroidSdbHostPort=10000",
                "-p:AndroidSdbTargetPort=10000",
                "-p:AdbTarget=-d"
            ],
            "group": "build",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "run-debug-android-waydroid",
            "command": "dotnet",
            "type": "shell",
            "args": [
                "build",
                "-t:Run",
                "${workspaceFolder}/gip.vbm.mobileApp/gip.vbm.mobileApp.csproj",
                "-p:TargetFramework=net10.0-android",
                "-p:Configuration=Debug",
                "-p:AndroidAttachDebugger=true",
                "-p:AndroidSdbHostPort=10000",
                "-p:AndroidSdbTargetPort=10000",
                "-p:AdbTarget=-s 192.168.240.112:5555"
            ],
            "group": "build",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "publish-release-datalogic-apk",
            "command": "dotnet",
            "type": "shell",
            "args": [
                "publish",
                "${workspaceFolder}/gip.vbm.mobileApp/gip.vbm.mobileApp.csproj",
                "-p:TargetFramework=net10.0-android",
                "-p:Configuration=ReleaseDatalogic",
                "-p:AndroidSigningKeyStore=${env:MOBILEMAUI_KEYSTORE_PATH}",
                "-o:${workspaceFolder}/publish-datalogic"
            ],
            "group": "build",
            "problemMatcher": "$msCompile"
        },
        {
            "label": "publish-release-zebra-apk",
            "command": "dotnet",
            "type": "shell",
            "args": [
                "publish",
                "${workspaceFolder}/gip.vbm.mobileApp/gip.vbm.mobileApp.csproj",
                "-p:TargetFramework=net10.0-android",
                "-p:Configuration=ReleaseZebra",
                "-p:AndroidSigningKeyStore=${env:MOBILEMAUI_KEYSTORE_PATH}",
                "-o:${workspaceFolder}/publish-zebra"
            ],
            "group": "build",
            "problemMatcher": "$msCompile"
        }
    ]
}